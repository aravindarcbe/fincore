# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - it's fine (and expected) to contain
# personal details like your IP and email, but never commit it just in case
# you later add anything sensitive to it.

aws_region        = "ap-south-1"
domain_name       = "aravindarcbe.com"
manage_dns_zone   = false

instance_type        = "t3.micro"
root_volume_size_gb  = 20

# Your own SSH public key (never the private key).
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Your current public IP with /32, e.g. "203.0.113.5/32".
# Find it with: curl -s https://checkip.amazonaws.com
allowed_ssh_cidr = "REPLACE_ME/32"

github_repo_url   = "https://github.com/aravindarcbe/fincore.git"
git_branch        = "main"

letsencrypt_email = "you@example.com"
