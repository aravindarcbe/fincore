# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - it's fine (and expected) to contain
# personal details like your IP and email, but never commit it just in case
# you later add anything sensitive to it.

aws_region        = "ap-south-1"
domain_name       = "aravindarcbe.com"
manage_dns_zone   = false

instance_type        = "t3.micro"
root_volume_size_gb  = 20

# Your own SSH public key CONTENT (never the private key). Since this needs
# to work identically whether run locally or from GitHub Actions, it's the
# key's text, not a file path. Easiest to set via an env var instead of
# pasting a long string here:
#   export TF_VAR_ssh_public_key="$(cat ~/.ssh/fincore_ed25519.pub)"
# or uncomment and paste it directly:
# ssh_public_key = "ssh-ed25519 AAAA... fincore-server"

# Your current public IP with /32, e.g. "203.0.113.5/32".
# Find it with: curl -s https://checkip.amazonaws.com
allowed_ssh_cidr = "REPLACE_ME/32"

github_repo_url   = "https://github.com/aravindarcbe/fincore.git"
git_branch        = "main"

letsencrypt_email = "you@example.com"
